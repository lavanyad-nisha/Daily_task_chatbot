# Copy to .env and fill in. Never commit .env.
DTB_OPENPROJECT_BASE_URL=https://openproject.example.com
DTB_OPENPROJECT_API_KEY=
DTB_OPENPROJECT_PROJECT_IDS=[]
DTB_GCHAT_SERVICE_ACCOUNT_FILE=secrets/service-account.json
DTB_GCHAT_READ_SPACES=[]
DTB_GCHAT_LOOKBACK_HOURS=24
DTB_EMPLOYEES_FILE=config/employees.json
DTB_LEAVE_FILE=config/leave.json
DTB_HOLIDAYS_FILE=config/holidays.json
DTB_TIMEZONE=Asia/Kolkata
DTB_RUN_SECRET=
DTB_DRY_RUN=true

# Jibble (fill from Jibble's official API documentation and organization settings).
# Never commit real values. Keep them only in .env (gitignored).
DTB_JIBBLE_CLIENT_ID=
DTB_JIBBLE_CLIENT_SECRET=
DTB_JIBBLE_TOKEN_URL=
DTB_JIBBLE_PEOPLE_BASE_URL=
DTB_JIBBLE_TIME_ENTRIES_BASE_URL=
