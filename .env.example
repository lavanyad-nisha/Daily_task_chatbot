# Copy to .env and fill in. Never commit .env.
DTB_OPENPROJECT_BASE_URL=https://openproject.example.com
DTB_OPENPROJECT_API_KEY=
DTB_OPENPROJECT_PROJECT_IDS=[]
DTB_GCHAT_SERVICE_ACCOUNT_FILE=secrets/service-account.json
DTB_GCHAT_READ_SPACES=[]
DTB_GCHAT_LOOKBACK_HOURS=24
DTB_EMPLOYEES_FILE=config/employees.json
DTB_LEAVE_FILE=config/leave.json
DTB_HOLIDAYS_FILE=config/holidays.json
DTB_TIMEZONE=Asia/Kolkata
DTB_RUN_SECRET=
DTB_DRY_RUN=true

# Jibble (fill from Jibble's official API documentation and organization settings).
# Never commit real values. Keep them only in .env (gitignored).
DTB_JIBBLE_CLIENT_ID=
DTB_JIBBLE_CLIENT_SECRET=
DTB_JIBBLE_TOKEN_URL=
DTB_JIBBLE_PEOPLE_BASE_URL=
DTB_JIBBLE_TIME_ENTRIES_BASE_URL=

# Google Chat endpoint (Chat app built as a Google Workspace add-on)
DTB_CHAT_ENDPOINT_AUDIENCE=https://openproject.example.com/daily-task-bot/chat
DTB_CHAT_ADDON_SERVICE_ACCOUNT=service-<PROJECT_NUMBER>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
DTB_PILOT_CHAT_USER_IDS=[]
# Client spaces (T1): who may LINK/UNLINK a space, and the clients with their OpenProject parent project.
DTB_BOT_ADMIN_CHAT_USER_IDS=[]
DTB_CLIENTS={"GPL":16,"L&T Valves":18,"TVS":27}
DTB_DATABASE_URL=
DTB_ALLOW_EXTERNAL_WRITES=false
DTB_BACKGROUND_SYNC_ENABLED=false

# Anthropic (Claude Haiku 5.5 for DSR summaries). Fill with the key from the TL. Never commit it.
ANTHROPIC_API_KEY=
